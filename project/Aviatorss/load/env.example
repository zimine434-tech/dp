# Скопируйте в load/.env и подставьте значения (файл load/.env в .gitignore).
# k6 читает переменные через -e или:  Get-Content load\.env | ForEach-Object { ... }

BASE_URL=http://127.0.0.1:8000

# Учётная запись LDAP — для login-*.js и teacher-*.js (обязательно заполнить)
K6_LOGIN=ваш_логин
K6_PASSWORD=ваш_пароль

# Пиковое число виртуальных пользователей (опционально)
K6_VUS=10
